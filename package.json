{
  "name": "magpie-translator",
  "version": "0.1.0",
  "description": "magpie plugin: translate one model's final reply with another configured model, into any target language, without writing the translation into the original session",
  "type": "module",
  "bin": {
    "magpie-translator": "./src/panel.mjs"
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "docs/DESIGN.md",
    "docs/panel_success.png",
    "docs/panel_failure.png",
    "docs/panel_settings.png",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "start": "node src/panel.mjs",
    "demo": "node script/demo.mjs",
    "e2e": "node script/e2e-magpie.mjs"
  },
  "keywords": [
    "magpie",
    "magpie-hooks",
    "translation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "magpie": {
    "hooks": "./src/hooks.mjs",
    "options": {
      "gatewayTimeoutMs": 2000,
      "panelPort": 44721,
      "language": "简体中文",
      "prompt": "",
      "style": "",
      "display": ["panel", "log"],
      "rules": []
    }
  }
}
