{
  "name": "magpie-translator",
  "version": "0.1.0",
  "description": "magpie plugin: translate one model's final reply with another configured model, into any target language, without writing the translation into the original session",
  "type": "module",
  "bin": {
    "magpie-translator": "./src/panel.mjs"
  },
  "files": [
    "src",
    "ui",
    "README.md",
    "README.zh-CN.md",
    "docs/DESIGN.md",
    "docs/panel_success.png",
    "docs/panel_failure.png",
    "docs/panel_settings.png",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "start": "node src/panel.mjs",
    "demo": "node script/demo.mjs",
    "e2e": "node script/e2e-magpie.mjs"
  },
  "keywords": [
    "magpie",
    "magpie-hooks",
    "translation",
    "magpie-plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "magpie": {
    "hooks": "./src/hooks.mjs",
    "middleware": "./src/middleware.mjs",
    "icon": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%0A%20%20%3Cdefs%3E%0A%20%20%20%20%3ClinearGradient%20id%3D%22g%22%20x1%3D%228%22%20y1%3D%224%22%20x2%3D%2256%22%20y2%3D%2260%22%20gradientUnits%3D%22userSpaceOnUse%22%3E%0A%20%20%20%20%20%20%3Cstop%20offset%3D%220%22%20stop-color%3D%22%237b7bf0%22%2F%3E%0A%20%20%20%20%20%20%3Cstop%20offset%3D%220.55%22%20stop-color%3D%22%235b5bd6%22%2F%3E%0A%20%20%20%20%20%20%3Cstop%20offset%3D%221%22%20stop-color%3D%22%234646b8%22%2F%3E%0A%20%20%20%20%3C%2FlinearGradient%3E%0A%20%20%3C%2Fdefs%3E%0A%20%20%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%235b5bd6%22%2F%3E%0A%20%20%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22url(%23g)%22%2F%3E%0A%20%20%3Cg%20fill%3D%22none%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%222.4%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20transform%3D%22translate(14.2%2014.2)%20scale(1.48)%22%3E%0A%20%20%20%20%3Cpath%20d%3D%22M4%205h9M8.5%203v2M6%205c.6%203%202.6%205.4%205%206.5M11%205c-.7%203.4-3%206-6.5%207.5%22%2F%3E%0A%20%20%20%20%3Cpath%20d%3D%22M13%2021l3.8-9h.4L21%2021M14.3%2018h5.4%22%2F%3E%0A%20%20%3C%2Fg%3E%0A%3C%2Fsvg%3E",
    "page": {
      "title": "Translations",
      "titles": {
        "zh": "翻译记录"
      },
      "file": "ui/history.html",
      "icon": "ui/icon.svg"
    },
    "panels": [
      {
        "slot": "settings",
        "file": "ui/settings.html",
        "title": "Translator",
        "titles": {
          "zh": "翻译设置"
        }
      }
    ],
    "permissions": [
      "providers:list",
      "usage:summary"
    ],
    "options": {
      "gatewayTimeoutMs": 2000,
      "panelPort": 44721,
      "language": "简体中文",
      "prompt": "",
      "style": "",
      "display": [
        "log"
      ],
      "localPanel": false,
      "rewriteSameLanguage": false,
      "translateTimeoutMs": 120000,
      "historyLimit": 500,
      "rules": []
    }
  }
}
