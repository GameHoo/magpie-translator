{
  "name": "@magpie-community/page-translator",
  "version": "0.2.0",
  "description": "A second model rewrites one model's final reply in the style your prompt asks, shown on its own page and never written back into the session",
  "type": "module",
  "files": [
    "page",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-hooks",
    "rewrite",
    "translation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GameHoo/magpie-translator.git",
    "directory": "."
  },
  "magpie": {
    "hooks": "./src/hooks.mjs",
    "page": {
      "title": "Translations",
      "titles": {
        "zh": "翻译记录"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "panels": [
      {
        "slot": "settings",
        "file": "page/settings.html",
        "title": "Translator",
        "titles": {
          "zh": "翻译设置"
        }
      }
    ],
    "permissions": [
      "providers:list",
      "usage:summary"
    ],
    "options": {
      "enabled": true,
      "language": "简体中文",
      "prompt": "",
      "style": "",
      "display": ["log"],
      "placement": "beside",
      "showTranslatorBadge": true,
      "collapseOriginal": false,
      "rewriteSameLanguage": false,
      "translateTimeoutMs": 120000,
      "historyLimit": 500,
      "rules": []
    }
  }
}
